{
    "name": "Strippet Browser (Node 24)",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "24"
        }
    },
    "remoteUser": "vscode",
    "containerEnv": {
        "npm_config_registry": "https://packagefeedproxy.microsoft.io/npm/",
        "npm_config_ignore_scripts": "true",
        "CHOKIDAR_USEPOLLING": "true"
    },
    "mounts": [
        "source=${devcontainerId}-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume"
    ],
    "postCreateCommand": "sudo -n chown vscode:vscode node_modules && node --version && npm --version && npm config get registry",
    "forwardPorts": [8080, 8090],
    "portsAttributes": {
        "8080": {
            "label": "Power BI visual (HTTPS)",
            "protocol": "https",
            "onAutoForward": "notify"
        },
        "8090": {
            "label": "Packaged Strippet Browser preview",
            "protocol": "http",
            "onAutoForward": "notify"
        }
    }
}