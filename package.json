{
  "name": "strippetbrowser",
  "version": "1.0.3",
  "description": "Strippets Browser PowerBI custom visual",
  "main": "src/index.js",
  "scripts": {
    "install-certificate": "pbiviz --install-cert",
    "start": "npm run dev",
    "tdd": "npm run test:tdd",
    "dev": "npm run styles && pbiviz start",
    "styles": "node bin/compileStyles",
    "package": "npm run typecheck && npm run styles && pbiviz package",
    "test": "npm run styles && karma start",
    "test:security": "node bin/testSecurity",
    "test:build": "node bin/testBuild",
    "test:tdd": "npm run styles && karma start --color --tdd",
    "preview": "node bin/preview",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit",
    "lint": "eslint src/**/*.ts",
    "validate": "npm run lint && npm run typecheck && npm test && npm run test:security && npm run package && npm run test:build",
    "clean": "rm -rf node_modules .tmp"
  },
  "config": {},
  "keywords": [],
  "author": "Uncharted Software Inc.",
  "license": "SEE LICENSE IN LICENSE",
  "privacyTerms": "https://privacy.microsoft.com/en-US/privacystatement/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Microsoft/PowerBI-visuals-StrippetsBrowser"
  },
  "privateSubmodules": {
    "@uncharted/strippets.common": "0.2.7",
    "@uncharted/strippets": "0.4.52",
    "@uncharted/thumbnails": "1.0.14"
  },
  "devDependencies": {
    "@types/bluebird": "^3.5.42",
    "@types/chai": "^4.3.20",
    "@types/jquery": "^3.5.33",
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "@types/sinon": "^21.0.0",
    "@types/sinon-chai": "^3.2.12",
    "chai": "^4.5.0",
    "css-loader": "^7.1.4",
    "style-loader": "^4.0.0",
    "fs-extra": "^11.3.4",
    "handlebars": "^4.7.8",
    "handlebars-loader": "^1.7.3",
    "jszip": "^3.10.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-mocha": "^2.0.1",
    "karma-sinon-chai": "^2.0.2",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-webpack": "^5.0.1",
    "mocha": "^12.0.1",
    "powerbi-visuals-tools": "7.2.1",
    "sass": "^1.98.0",
    "sinon": "^21.0.0",
    "sinon-chai": "^3.7.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "powerbi-visuals-api": "5.11.1",
    "webpack": "^5.105.4",
    "eslint": "^9.39.0",
    "@typescript-eslint/parser": "^8.50.0",
    "@playwright/test": "^1.58.2",
    "sharp": "^0.35.4"
  },
  "dependencies": {
    "@uncharted/strippets": "file:lib/@uncharted/strippets",
    "@uncharted/strippets.common": "file:lib/@uncharted/strippets.common",
    "@uncharted/thumbnails": "file:lib/@uncharted/thumbnails",
    "dompurify": "^3.4.15",
    "bluebird": "^3.7.2",
    "font-awesome": "^4.7.0",
    "jquery": "^3.7.1",
    "lodash": "^4.17.23",
    "mediator-js": "^0.11.0",
    "moment": "^2.30.1",
